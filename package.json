{
  "name": "cyphrdrive",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/docker-compose.yml down",
    "clean": "turbo clean && rm -rf node_modules **/*/node_modules",
    "telemetry:clean": "pnpm --filter @cyphrdrive/api exec ts-node src/scripts/clean-telemetry.ts",
    "telemetry:stream": "pnpm --filter @cyphrdrive/api exec ts-node src/scripts/stream-tunis-telematics.ts",
    "fleet:import": "pnpm --filter @cyphrdrive/api exec ts-node src/scripts/import-fleet-csv.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.2"
  },
  "packageManager": "pnpm@9.4.0"
}